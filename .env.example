# Copy to .env in the project root. Do not place .env in dist/.
# Node.js 22 or 24; MySQL 5.7.24 is the compatibility target.
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=leinz_lens_studio
MYSQL_USER=leinz_app
MYSQL_PASSWORD="replace-with-database-password"
MYSQL_POOL_SIZE=5
# Optional PEM CA path. If supplied, TLS certificate validation stays enabled.
MYSQL_SSL_CA=

SESSION_HOURS=8
# For the admin:create command only; leave blank for an interactive prompt.
# Never use a sample or default password for a real installation.
ADMIN_USERNAME=
ADMIN_PASSWORD=
